# Copy to .env and fill in credentials (do not commit .env).
#
# Use localhost when Postgres runs on this machine. If the DB is on another host,
# replace HOST with that machine's IP or hostname.
#
POLYTEMPO_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/polytempo
POLYTEMPO_PAPER_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/polytempo_paper
POLYTEMPO_LIVE_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/polytempo_live
POLYTEMPO_TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/polytempo_test
POLYTEMPO_PAPER_TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/polytempo_paper_test

# Live trading only. Real orders need BOTH of these AND mode: live in
# config/live_node.yaml — leave commented while the node runs dry_run.
# POLYMARKET_PRIVATE_KEY=
# POLYTEMPO_LIVE_CONFIRM=1
#
# Optional: the wallet to trade for. Omit and the SDK derives it from the
# signer. Set it explicitly when the signer controls a Magic/Google proxy
# wallet, so the node cannot pick the wrong one.
# POLYMARKET_WALLET_ADDRESS=

# polytempo-health.sh log tail lengths (defaults: 80 / 30)
# POLYTEMPO_HEALTH_ERR_LINES=80
# POLYTEMPO_HEALTH_OUT_LINES=30
