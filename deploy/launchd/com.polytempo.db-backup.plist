<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchDaemon: database backups (--once) at 02:00 mac0 local time.
  Requires pg_dump on PATH (run-with-env.sh prepends Homebrew prefixes).
  Full install: docs/mac0-setup.md
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.polytempo.db-backup</string>

    <key>UserName</key>
    <string>jnlow</string>
    <key>GroupName</key>
    <string>staff</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/jnlow/projects/PolyTempo/deploy/bin/run-with-env.sh</string>
        <string>scripts/backup_databases.py</string>
        <string>--once</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/jnlow/projects/PolyTempo</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>2</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/jnlow/projects/PolyTempo/logs/db-backup.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/jnlow/projects/PolyTempo/logs/db-backup.err.log</string>
</dict>
</plist>
