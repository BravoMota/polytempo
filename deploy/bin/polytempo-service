#!/usr/bin/env bash
# Control PolyTempo LaunchDaemons on mac0 (typically via sudo).
set -euo pipefail

DOMAIN="system"
ALL_JOBS=(collector paper-bot calibration db-backup)

usage() {
  cat <<EOF
Usage: polytempo-service <command> [job]

Commands:
  status [job|all]              launchctl print for one or all jobs
  restart collector|paper-bot|all   kickstart -k long-lived jobs
  run calibration|db-backup     kickstart calendar jobs (--once via plist)

Jobs: ${ALL_JOBS[*]}
EOF
}

resolve_label() {
  case "$1" in
    collector) echo com.polytempo.collector ;;
    paper-bot) echo com.polytempo.paper-bot ;;
    calibration) echo com.polytempo.calibration ;;
    db-backup) echo com.polytempo.db-backup ;;
    *)
      echo "Unknown job: $1" >&2
      exit 1
      ;;
  esac
}

is_long_lived() {
  case "$1" in
    collector | paper-bot) return 0 ;;
    *) return 1 ;;
  esac
}

is_calendar() {
  case "$1" in
    calibration | db-backup) return 0 ;;
    *) return 1 ;;
  esac
}

cmd_status() {
  local target="${1:-all}"
  if [[ "$target" == "all" ]]; then
    local job
    for job in "${ALL_JOBS[@]}"; do
      echo "=== $job ==="
      cmd_status "$job"
      echo
    done
    return
  fi
  local label
  label="$(resolve_label "$target")"
  launchctl print "${DOMAIN}/${label}"
}

cmd_restart() {
  local target="${1:-}"
  if [[ -z "$target" ]]; then
    usage
    exit 1
  fi
  if [[ "$target" == "all" ]]; then
    cmd_restart collector
    cmd_restart paper-bot
    return
  fi
  if ! is_long_lived "$target"; then
    echo "restart applies only to long-lived jobs: collector, paper-bot, all" >&2
    exit 1
  fi
  local label
  label="$(resolve_label "$target")"
  launchctl kickstart -k "${DOMAIN}/${label}"
  echo "Restarted ${DOMAIN}/${label}"
}

cmd_run() {
  local target="${1:-}"
  if [[ -z "$target" ]]; then
    usage
    exit 1
  fi
  if ! is_calendar "$target"; then
    echo "run applies only to calendar jobs: calibration, db-backup" >&2
    exit 1
  fi
  local label
  label="$(resolve_label "$target")"
  launchctl kickstart "${DOMAIN}/${label}"
  echo "Triggered ${DOMAIN}/${label}"
}

main() {
  local cmd="${1:-}"
  shift || true

  case "$cmd" in
    status) cmd_status "${1:-all}" ;;
    restart) cmd_restart "${1:-}" ;;
    run) cmd_run "${1:-}" ;;
    "" | -h | --help) usage ;;
    *)
      echo "Unknown command: $cmd" >&2
      usage
      exit 1
      ;;
  esac
}

main "$@"
