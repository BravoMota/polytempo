# Single Runs — archived model forecast for predicted daily Tmax (NOT observations).
# Host: single-runs-api.open-meteo.com (offline calibration only; see fetch-historical-forecasts).
#
# @run_time     UTC model init sent as run= (when the forecast was issued).
# @target_date  NOT in the URL — after response, read daily.time[i]==target_date → temperature_2m_max[i].
# Do not send start_date/end_date with run. Archive calls can take 30–120s.

@latitude = 51.5053
@longitude = 0.0553
@model = ukmo_uk_deterministic_2km
@run_time = 2026-06-10T12:00
@target_date = 2026-06-10
@timezone = Europe/London

GET https://single-runs-api.open-meteo.com/v1/forecast?latitude={{latitude}}&longitude={{longitude}}&daily=temperature_2m_max&temperature_unit=celsius&models={{model}}&timezone={{timezone}}&run={{run_time}}

#test
GET https://single-runs-api.open-meteo.com/v1/forecast?latitude=51.5053&longitude=0.0553&daily=temperature_2m_max&temperature_unit=celsius&models=icon_eu&timezone=Europe%2FLondon&run=2026-02-08T21%3A00&forecast_days=5